<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" InitialTargets="EnsureWixToolsetInstalled" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x86</Platform>
    <ProductVersion>3.10</ProductVersion>
    <ProjectGuid>9567c3f8-0cc1-477d-aeb5-365690825d69</ProjectGuid>
    <SchemaVersion>2.0</SchemaVersion>
    <OutputName>Autotech.Desktop.Setup</OutputName>
    <OutputType>Package</OutputType>
    <DefineSolutionProperties>false</DefineSolutionProperties>

    <!--
      The version stamped into the MSI. Do NOT reuse the ProductVersion property above
      for this - that is the WiX project schema version (3.10), and feeding it to
      Product/@Version pins every MSI at 3.10, which stops MajorUpgrade from ever firing.
      version.ps1 passes /p:AppVersion; a plain Visual Studio build falls back to
      version.txt so it still produces a correctly versioned MSI.
    -->
    <AppVersionFile>$(MSBuildThisFileDirectory)..\version.txt</AppVersionFile>
    <AppVersion Condition=" '$(AppVersion)' == '' AND Exists('$(AppVersionFile)') ">$([System.IO.File]::ReadAllText($(AppVersionFile)).Trim())</AppVersion>
    <AppVersion Condition=" '$(AppVersion)' == '' ">0.0.0.0</AppVersion>

    <!-- Output of the self-contained win-x64 Release publish. -->
    <AppPublishDir Condition=" '$(AppPublishDir)' == '' ">$(MSBuildThisFileDirectory)..\Autotech.Desktop.Main\bin\Release\net10.0-windows7.0\win-x64\publish\</AppPublishDir>

    <DefineConstants>
      ProductVersion=$(AppVersion);
      PublishDir=$(AppPublishDir)
    </DefineConstants>
  </PropertyGroup>
  <!-- DefineConstants is set once above so it cannot drift between configurations. -->
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x86' ">
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Product.wxs" />
    <Compile Include="ProductFiles.wxs" />
  </ItemGroup>
  <Import Project="$(WixTargetsPath)" Condition=" '$(WixTargetsPath)' != '' " />
  <Import Project="C:\Program Files (x86)\MSBuild\Microsoft\WiX\v3.x\Wix.targets" Condition=" '$(WixTargetsPath)' == '' AND Exists('C:\Program Files (x86)\MSBuild\Microsoft\WiX\v3.x\Wix.targets') " />
  <Target Name="EnsureWixToolsetInstalled" Condition=" '$(WixTargetsImported)' != 'true' ">
    <Error Text="The WiX Toolset v3.11 build tools must be installed to build this project. To download the WiX Toolset, see https://wixtoolset.org/releases/v3.11/stable" />
  </Target>
</Project>