<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Autotech.Desktop.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Autotech.Desktop.MAUI.Views"
    Title="StockPilot Pro ERP"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Loading"
        ContentTemplate="{DataTemplate views:LoadingPage}"
        Route="LoadingPage" />

    <ShellContent
        Title="StockPilot Pro ERP"
        ContentTemplate="{DataTemplate views:DashboardPage}"
        Route="DashboardPage" />

</Shell>
