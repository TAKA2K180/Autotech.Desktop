<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Name="DashboardRoot"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Autotech.Desktop.MAUI.Views.DashboardPage"
             Title="Autotech">

    <Grid RowDefinitions="Auto,*" BackgroundColor="{AppThemeBinding Light=#F6FAF8, Dark=#111817}">
        <Grid Padding="18,12"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12"
              BackgroundColor="{AppThemeBinding Light=White, Dark=#17211F}">
            <VerticalStackLayout Spacing="2">
                <Label Text="Autotech POS System"
                       FontSize="20"
                       FontAttributes="Bold" />
                <Label Text="{Binding AgentMeta}"
                       TextColor="{AppThemeBinding Light=#52615E, Dark=#B7C8C4}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Button Text="Refresh" Command="{Binding RefreshCommand}" />
                <Button Text="Logout" Command="{Binding LogoutCommand}" BackgroundColor="#52615E" />
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1" Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="14">
                <HorizontalStackLayout Grid.Row="0" Spacing="8">
                    <Button Text="Sales" Command="{Binding SelectTabCommand}" CommandParameter="POS" />
                    <Button Text="Invoice" Command="{Binding SelectTabCommand}" CommandParameter="Invoice" />
                    <Button Text="Maintenance"
                            IsVisible="{Binding CanAccessMaintenance}"
                            Command="{Binding SelectTabCommand}"
                            CommandParameter="Maintenance" />
                </HorizontalStackLayout>

                <Label Grid.Row="1"
                       Text="{Binding OperationMessage}"
                       IsVisible="{Binding HasOperationMessage}"
                       TextColor="#B42318" />

                <Grid Grid.Row="2"
                      IsVisible="{Binding IsPosTab}"
                      RowDefinitions="*,Auto"
                      RowSpacing="14">
                    <FlexLayout x:Name="SalesPanels"
                                Grid.Row="0"
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Stretch"
                                JustifyContent="SpaceBetween">
                        <Border Padding="12"
                                x:Name="ItemsPanel"
                                Margin="0,0,12,12"
                                FlexLayout.Basis="640"
                                FlexLayout.Grow="1"
                                FlexLayout.Shrink="1"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#17211F}">
                            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Image Source="logo.jpg" HeightRequest="68" WidthRequest="68" Aspect="AspectFit" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="{Binding SalesClock}" FontAttributes="Bold" />
                                        <Label Text="{Binding AgentName, StringFormat='Cashier: {0}'}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="{Binding ItemsPageText}"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#52615E, Dark=#B7C8C4}" />
                                </Grid>

                                <FlexLayout Grid.Row="1" Direction="Row" Wrap="Wrap" AlignItems="Center">
                                    <SearchBar Placeholder="Search item..."
                                               Text="{Binding ItemSearchText}"
                                               FlexLayout.Basis="280" />
                                    <Picker Title="Pricing"
                                            ItemsSource="{Binding PricingModes}"
                                            SelectedItem="{Binding PricingMode}"
                                            WidthRequest="160"
                                            Margin="8,0,0,0" />
                                    <Picker Title="Location"
                                            ItemsSource="{Binding Locations}"
                                            SelectedItem="{Binding SelectedLocation}"
                                            WidthRequest="170"
                                            Margin="8,0,0,0" />
                                </FlexLayout>

                                <ScrollView x:Name="ItemsScroll"
                                            Grid.Row="2"
                                            Orientation="Horizontal"
                                            HorizontalOptions="Fill"
                                            HorizontalScrollBarVisibility="Always">
                                    <CollectionView x:Name="ItemsList"
                                                    WidthRequest="1280"
                                                    HorizontalOptions="Start"
                                                    ItemsSource="{Binding Items}"
                                                    SelectionMode="Single"
                                                    SelectionChanged="ItemsCollection_SelectionChanged"
                                                    HeightRequest="390">
                                        <CollectionView.Header>
                                            <Grid Padding="8" ColumnDefinitions="520,150,120,490" ColumnSpacing="10" BackgroundColor="#E8F2EF">
                                                <Label Text="Item Name" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                                <Label Grid.Column="1" Text="Quantity Per Box" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                                <Label Grid.Column="2" Text="Onhand" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                                <Label Grid.Column="3" Text="Item Description" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                            </Grid>
                                        </CollectionView.Header>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="0" StrokeThickness="0" BackgroundColor="Transparent">
                                                    <Grid Padding="8" ColumnDefinitions="520,150,120,490" ColumnSpacing="10">
                                                        <Label Text="{Binding ItemName}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                        <Label Grid.Column="1" Text="{Binding itemDetails.QuantityPerBox, StringFormat='{0:N0}'}" FontSize="16" />
                                                        <Label Grid.Column="2" Text="{Binding itemDetails.OnHand, StringFormat='{0:N0}'}" FontSize="16" />
                                                        <Label Grid.Column="3" Text="{Binding ItemDescription}" FontSize="16" LineBreakMode="TailTruncation" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </ScrollView>

                                <HorizontalStackLayout Grid.Row="3"
                                                       Spacing="8"
                                                       HeightRequest="46"
                                                       VerticalOptions="End">
                                    <Button Text="&lt;&lt;" Command="{Binding PreviousItemsCommand}" />
                                    <Button Text="&gt;&gt;" Command="{Binding NextItemsCommand}" />
                                    <Label Text="{Binding ItemsCount, StringFormat='{0} visible'}"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#52615E, Dark=#B7C8C4}" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                        <Border Padding="12"
                                Margin="0,0,0,12"
                                FlexLayout.Basis="620"
                                FlexLayout.Grow="1"
                                FlexLayout.Shrink="1"
                                BackgroundColor="{AppThemeBinding Light=White, Dark=#17211F}">
                            <Grid RowDefinitions="52,52,32,*,46" RowSpacing="8">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Label Text="Account:" VerticalOptions="Center" />
                                    <Picker Grid.Column="1"
                                            ItemsSource="{Binding Accounts}"
                                            ItemDisplayBinding="{Binding Name}"
                                            SelectedItem="{Binding SelectedAccount}"
                                            HorizontalOptions="Start"
                                            WidthRequest="420"
                                            MaximumWidthRequest="520"
                                            HeightRequest="36"
                                            VerticalOptions="Center" />
                                </Grid>

                                <Grid Grid.Row="1" ColumnDefinitions="Auto,420,Auto,80" ColumnSpacing="10" HorizontalOptions="Start">
                                    <Label Text="Contact:" VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding ContactNumber}"
                                           IsReadOnly="True"
                                           HeightRequest="36"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="Terms:" VerticalOptions="Center" />
                                    <Entry Grid.Column="3"
                                           Text="{Binding Terms}"
                                           Keyboard="Numeric"
                                           HeightRequest="36"
                                           VerticalOptions="Center" />
                                </Grid>

                                <Label Grid.Row="2"
                                       Text="Order Cart"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />
                                    <CollectionView x:Name="CartList"
                                                    Grid.Row="3"
                                                    ItemsSource="{Binding CartItems}"
                                                    SelectionMode="None"
                                                    Margin="0,4,8,0"
                                                    VerticalOptions="Fill"
                                                    HorizontalOptions="Fill">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="12"
                                                        Margin="0,0,0,10"
                                                        Stroke="#2D3D39"
                                                        BackgroundColor="{AppThemeBinding Light=#F8FBFA, Dark=#101B18}">
                                                    <Grid RowDefinitions="Auto,Auto"
                                                          ColumnDefinitions="36,*"
                                                          ColumnSpacing="10"
                                                          RowSpacing="12">
                                                        <CheckBox IsChecked="{Binding IsSelected}"
                                                                  VerticalOptions="Start"
                                                                  HorizontalOptions="Center" />

                                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                            <Label Text="{Binding ItemName}"
                                                                   FontSize="14"
                                                                   FontAttributes="Bold"
                                                                   LineBreakMode="TailTruncation" />
                                                            <Label Text="{Binding ItemCode}"
                                                                   FontSize="12"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light=#52615E, Dark=#B7C8C4}" />
                                                        </VerticalStackLayout>

                                                        <Grid Grid.Row="1"
                                                              Grid.ColumnSpan="2"
                                                              ColumnDefinitions="100,100,110,120"
                                                              ColumnSpacing="14"
                                                              HorizontalOptions="Start">
                                                            <VerticalStackLayout Spacing="2">
                                                                <Label Text="Price" FontSize="12" TextColor="{AppThemeBinding Light=#52615E, Dark=#B7C8C4}" />
                                                                <Label Text="{Binding UnitPriceText}" FontSize="14" />
                                                            </VerticalStackLayout>

                                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                                <Label Text="Qty" FontSize="12" TextColor="{AppThemeBinding Light=#52615E, Dark=#B7C8C4}" />
                                                                <Entry Text="{Binding QuantityText}" Keyboard="Numeric" WidthRequest="88" HeightRequest="34" />
                                                            </VerticalStackLayout>

                                                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                                                <Label Text="Disc %" FontSize="12" TextColor="{AppThemeBinding Light=#52615E, Dark=#B7C8C4}" />
                                                                <Entry Text="{Binding DiscountText}" Keyboard="Numeric" WidthRequest="92" HeightRequest="34" />
                                                            </VerticalStackLayout>

                                                            <VerticalStackLayout Grid.Column="3" Spacing="2">
                                                                <Label Text="Subtotal" FontSize="12" TextColor="{AppThemeBinding Light=#52615E, Dark=#B7C8C4}" />
                                                                <Label Text="{Binding SubtotalText}" FontSize="14" FontAttributes="Bold" />
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>

                                <HorizontalStackLayout Grid.Row="4"
                                                       Spacing="8"
                                                       VerticalOptions="End"
                                                       HorizontalOptions="Start">
                                    <Button Text="Remove selected"
                                            Command="{Binding RemoveSelectedCartItemsCommand}"
                                            HeightRequest="40"
                                            VerticalOptions="Center" />
                                    <Button Text="Clear"
                                            Command="{Binding ClearCartCommand}"
                                            BackgroundColor="#52615E"
                                            HeightRequest="40"
                                            VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </FlexLayout>

                    <Border Grid.Row="1"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#17211F}">
                        <FlexLayout Direction="Row"
                                    Wrap="Wrap"
                                    AlignItems="Stretch"
                                    JustifyContent="Start">
                            <VerticalStackLayout Margin="0,0,18,0"
                                                 FlexLayout.Basis="360"
                                                 FlexLayout.Grow="0"
                                                 Spacing="8">
                                <Label Text="Payment" FontAttributes="Bold" />
                                <Picker ItemsSource="{Binding PaymentMethods}"
                                        ItemDisplayBinding="{Binding Description}"
                                        SelectedItem="{Binding SelectedPaymentMethod}" />
                                <Label Text="Paid Amount" />
                                <Entry Text="{Binding PaidAmountText}" Keyboard="Numeric" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <Label Text="{Binding ChangeText, StringFormat='Change: {0}'}" />
                                    <Label Grid.Column="1" Text="{Binding RemainingText, StringFormat='Remaining: {0}'}" />
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Margin="0,0,18,0"
                                                 FlexLayout.Basis="340"
                                                 FlexLayout.Grow="0"
                                                 Spacing="8">
                                <Label Text="Totals" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                                    <Label Text="Subtotal" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding SubtotalText}" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                                    <Label Text="Tax" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding TaxText}" Keyboard="Numeric" />
                                </Grid>
                                <Grid ColumnDefinitions="110,*" ColumnSpacing="10">
                                    <Label Text="Discount" VerticalOptions="Center" />
                                    <Entry Grid.Column="1" Text="{Binding InvoiceDiscountText}" Keyboard="Numeric" />
                                </Grid>
                            </VerticalStackLayout>

                            <Border Padding="14"
                                    FlexLayout.Basis="360"
                                    FlexLayout.Grow="0"
                                    Stroke="#2D3D39"
                                    BackgroundColor="{AppThemeBinding Light=#F8FBFA, Dark=#101B18}">
                                <VerticalStackLayout Spacing="12" VerticalOptions="Center">
                                    <Label Text="Amount Due"
                                           TextColor="{AppThemeBinding Light=#52615E, Dark=#B7C8C4}" />
                                    <Label Text="{Binding TotalText}"
                                           FontSize="28"
                                           FontAttributes="Bold" />
                                    <Button Text="Pay"
                                            HeightRequest="52"
                                            WidthRequest="320"
                                            HorizontalOptions="Start"
                                            Command="{Binding PayCommand}" />
                                </VerticalStackLayout>
                            </Border>
                        </FlexLayout>
                    </Border>
                </Grid>

                <Grid Grid.Row="2"
                      IsVisible="{Binding IsInvoiceTab}"
                      RowDefinitions="Auto,*,Auto"
                      RowSpacing="12">
                    <FlexLayout Grid.Row="0"
                                Direction="Row"
                                Wrap="Wrap"
                                AlignItems="End">
                        <VerticalStackLayout Spacing="4" Margin="0,0,12,0">
                            <Label Text="Filter By:" />
                            <Picker ItemsSource="{Binding InvoiceFilterOptions}"
                                    ItemDisplayBinding="{Binding Description}"
                                    SelectedItem="{Binding SelectedInvoiceFilter}"
                                    WidthRequest="190" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4" Margin="0,0,12,0" IsVisible="{Binding IsInvoiceDateFilter}">
                            <Label Text="Date From" />
                            <DatePicker Date="{Binding InvoiceDateFrom}" WidthRequest="160" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4" Margin="0,0,12,0" IsVisible="{Binding IsInvoiceDateFilter}">
                            <Label Text="Date To" />
                            <DatePicker Date="{Binding InvoiceDateTo}" WidthRequest="160" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4" Margin="0,0,12,0" IsVisible="{Binding IsInvoiceDateFilter}">
                            <Label Text="Sort" />
                            <Picker ItemsSource="{Binding InvoiceDateSortOptions}"
                                    SelectedItem="{Binding InvoiceDateSortOption}"
                                    WidthRequest="150" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4" Margin="0,0,12,0">
                            <Label Text="Search Invoice" />
                            <SearchBar Placeholder="Search invoices..."
                                       Text="{Binding InvoiceSearchText}"
                                       WidthRequest="260" />
                        </VerticalStackLayout>

                        <Button Text="Search"
                                Command="{Binding SearchInvoicesCommand}"
                                WidthRequest="150" />
                        <Label Text="{Binding InvoicesCount, StringFormat='{0} invoices'}"
                               Margin="12,0,0,0"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#52615E, Dark=#B7C8C4}" />
                    </FlexLayout>

                    <Border x:Name="InvoiceGridPanel"
                            Grid.Row="1"
                            Padding="10"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#17211F}">
                        <ScrollView x:Name="InvoiceScroll"
                                    Orientation="Horizontal"
                                    HorizontalOptions="Fill"
                                    HorizontalScrollBarVisibility="Always">
                            <CollectionView x:Name="InvoiceList"
                                            ItemsSource="{Binding Invoices}"
                                            HorizontalOptions="Fill"
                                            SelectionMode="Single"
                                            SelectionChanged="InvoicesCollection_SelectionChanged"
                                            WidthRequest="2100">
                                <CollectionView.Header>
                                    <Grid Padding="10"
                                          ColumnDefinitions="120,150,160,280,160,140,120,130,120,140,180,130,130"
                                          ColumnSpacing="10"
                                          MinimumHeightRequest="46"
                                          BackgroundColor="#E8F2EF">
                                        <Label Text="Invoice #" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                        <Label Grid.Column="1" Text="Date Sold" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                        <Label Grid.Column="2" Text="Agent Name" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                        <Label Grid.Column="3" Text="Customer Name" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                        <Label Grid.Column="4" Text="Payment Method" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                        <Label Grid.Column="5" Text="Total Sales" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                        <Label Grid.Column="6" Text="Tax Amount" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                        <Label Grid.Column="7" Text="Discount (₱)" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                        <Label Grid.Column="8" Text="Terms (Days)" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                        <Label Grid.Column="9" Text="Due Date" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                        <Label Grid.Column="10" Text="Balance Remaining" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                        <Label Grid.Column="11" Text="Status" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                        <Label Grid.Column="12" Text="Cluster" FontSize="16" FontAttributes="Bold" TextColor="#12312D" />
                                    </Grid>
                                </CollectionView.Header>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border StrokeThickness="0" BackgroundColor="{Binding RowBackground}">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroup Name="CommonStates">
                                                    <VisualState Name="Normal" />
                                                    <VisualState Name="Selected">
                                                        <VisualState.Setters>
                                                            <Setter Property="BackgroundColor" Value="#38DCC8" />
                                                            <Setter Property="Stroke" Value="#FFFFFF" />
                                                            <Setter Property="StrokeThickness" Value="2" />
                                                        </VisualState.Setters>
                                                    </VisualState>
                                                </VisualStateGroup>
                                            </VisualStateManager.VisualStateGroups>
                                            <Grid Padding="10"
                                                  ColumnDefinitions="120,150,160,280,160,140,120,130,120,140,180,130,130"
                                                  ColumnSpacing="10"
                                                  MinimumHeightRequest="56">
                                                <Label Text="{Binding InvoiceNumber}" FontSize="16" FontAttributes="Bold" TextColor="{Binding RowTextColor}" />
                                                <Label Grid.Column="1" Text="{Binding DateSoldText}" FontSize="16" TextColor="{Binding RowTextColor}" />
                                                <Label Grid.Column="2" Text="{Binding AgentName}" FontSize="16" TextColor="{Binding RowTextColor}" />
                                                <Label Grid.Column="3" Text="{Binding CustomerName}" FontSize="16" TextColor="{Binding RowTextColor}" LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="4" Text="{Binding PaymentMethod}" FontSize="16" TextColor="{Binding RowTextColor}" />
                                                <Label Grid.Column="5" Text="{Binding TotalSalesText}" FontSize="16" TextColor="{Binding RowTextColor}" />
                                                <Label Grid.Column="6" Text="{Binding TaxAmountText}" FontSize="16" TextColor="{Binding RowTextColor}" />
                                                <Label Grid.Column="7" Text="{Binding DiscountText}" FontSize="16" TextColor="{Binding RowTextColor}" />
                                                <Label Grid.Column="8" Text="{Binding TermsText}" FontSize="16" TextColor="{Binding RowTextColor}" />
                                                <Label Grid.Column="9" Text="{Binding DueDateText}" FontSize="16" TextColor="{Binding RowTextColor}" />
                                                <Label Grid.Column="10" Text="{Binding RemainingBalanceText}" FontSize="16" TextColor="{Binding RowTextColor}" />
                                                <Label Grid.Column="11" Text="{Binding Status}" FontSize="16" TextColor="{Binding RowTextColor}" />
                                                <Label Grid.Column="12" Text="{Binding Cluster}" FontSize="16" TextColor="{Binding RowTextColor}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </ScrollView>
                    </Border>

                    <HorizontalStackLayout Grid.Row="2" Spacing="10">
                        <Button Text="Open" WidthRequest="100" Clicked="OpenInvoice_Clicked" />
                        <Button Text="Export to Excel" WidthRequest="170" />
                    </HorizontalStackLayout>
                </Grid>

                <Grid Grid.Row="2"
                      IsVisible="{Binding IsMaintenanceTab}"
                      RowDefinitions="Auto,*,Auto"
                      RowSpacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Agents" Command="{Binding SelectMaintenanceTabCommand}" CommandParameter="Agents" />
                        <Button Text="Accounts" Command="{Binding SelectMaintenanceTabCommand}" CommandParameter="Accounts" />
                        <Button Text="Items" Command="{Binding SelectMaintenanceTabCommand}" CommandParameter="Items" />
                        <Button Text="Reports" Command="{Binding SelectMaintenanceTabCommand}" CommandParameter="Reports" />
                    </HorizontalStackLayout>

                    <Border x:Name="MaintenanceGridPanel"
                            Grid.Row="1"
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#17211F}">
                        <Grid>
                            <Grid IsVisible="{Binding IsMaintenanceAgentsTab}" RowDefinitions="Auto,*" RowSpacing="10">
                                <SearchBar Placeholder="Search agents" Text="{Binding MaintenanceAgentSearchText}" />
                                <CollectionView x:Name="MaintenanceAgentsList"
                                                Grid.Row="1"
                                                ItemsSource="{Binding MaintenanceAgents}"
                                                SelectedItem="{Binding SelectedMaintenanceAgent, Mode=TwoWay}"
                                                SelectionMode="Single"
                                                SelectionChanged="MaintenanceAgents_SelectionChanged">
                                    <CollectionView.Header>
                                        <Grid Padding="10" ColumnDefinitions="1.2*,*,*,*,*" ColumnSpacing="12" BackgroundColor="#E8F2EF">
                                            <Label Text="Agent Name" FontAttributes="Bold" TextColor="#12312D" />
                                            <Label Grid.Column="1" Text="Username" FontAttributes="Bold" TextColor="#12312D" />
                                            <Label Grid.Column="2" Text="Contact" FontAttributes="Bold" TextColor="#12312D" />
                                            <Label Grid.Column="3" Text="Role" FontAttributes="Bold" TextColor="#12312D" />
                                            <Label Grid.Column="4" Text="Last Login" FontAttributes="Bold" TextColor="#12312D" />
                                        </Grid>
                                    </CollectionView.Header>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border StrokeThickness="0" BackgroundColor="Transparent">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup Name="CommonStates">
                                                        <VisualState Name="Normal" />
                                                        <VisualState Name="Selected">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="#38DCC8" />
                                                                <Setter Property="Stroke" Value="#FFFFFF" />
                                                                <Setter Property="StrokeThickness" Value="2" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Grid Padding="10" ColumnDefinitions="1.2*,*,*,*,*" ColumnSpacing="12" MinimumHeightRequest="48">
                                                    <Label Text="{Binding AgentName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="1" Text="{Binding Username}" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="2" Text="{Binding AgentContactNumber}" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="3" Text="{Binding AgentRole}" />
                                                    <Label Grid.Column="4" Text="{Binding DateLastLogin, StringFormat='{0:g}'}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>

                            <Grid IsVisible="{Binding IsMaintenanceAccountsTab}" RowDefinitions="Auto,*" RowSpacing="10">
                                <SearchBar Placeholder="Search accounts" Text="{Binding MaintenanceAccountSearchText}" />
                                <CollectionView x:Name="MaintenanceAccountsList"
                                                Grid.Row="1"
                                                ItemsSource="{Binding MaintenanceAccounts}"
                                                SelectedItem="{Binding SelectedMaintenanceAccount, Mode=TwoWay}"
                                                SelectionMode="Single"
                                                SelectionChanged="MaintenanceAccounts_SelectionChanged">
                                    <CollectionView.Header>
                                        <Grid Padding="10" ColumnDefinitions="1.2*,*,1.8*,*,*" ColumnSpacing="12" BackgroundColor="#E8F2EF">
                                            <Label Text="Account Name" FontAttributes="Bold" TextColor="#12312D" />
                                            <Label Grid.Column="1" Text="Contact Person" FontAttributes="Bold" TextColor="#12312D" />
                                            <Label Grid.Column="2" Text="Address" FontAttributes="Bold" TextColor="#12312D" />
                                            <Label Grid.Column="3" Text="Contact" FontAttributes="Bold" TextColor="#12312D" />
                                            <Label Grid.Column="4" Text="Terms" FontAttributes="Bold" TextColor="#12312D" />
                                        </Grid>
                                    </CollectionView.Header>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Border StrokeThickness="0" BackgroundColor="Transparent">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup Name="CommonStates">
                                                        <VisualState Name="Normal" />
                                                        <VisualState Name="Selected">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="#38DCC8" />
                                                                <Setter Property="Stroke" Value="#FFFFFF" />
                                                                <Setter Property="StrokeThickness" Value="2" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Grid Padding="10" ColumnDefinitions="1.2*,*,1.8*,*,*" ColumnSpacing="12" MinimumHeightRequest="52">
                                                    <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="1" Text="{Binding ContactPerson}" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="2" Text="{Binding Address}" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="3" Text="{Binding ContactNumber}" LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="4" Text="{Binding Terms}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Grid>

                            <Grid IsVisible="{Binding IsMaintenanceItemsTab}" RowDefinitions="Auto,*" RowSpacing="10">
                                <SearchBar Placeholder="Search items" Text="{Binding MaintenanceItemSearchText}" />
                                <ScrollView x:Name="MaintenanceItemsScroll"
                                            Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalOptions="Fill"
                                            HorizontalScrollBarVisibility="Always">
                                    <CollectionView x:Name="MaintenanceItemsList"
                                                    ItemsSource="{Binding MaintenanceItems}"
                                                    SelectedItem="{Binding SelectedMaintenanceItem, Mode=TwoWay}"
                                                    SelectionMode="Single"
                                                    SelectionChanged="MaintenanceItems_SelectionChanged"
                                                    WidthRequest="2200">
                                        <CollectionView.Header>
                                            <Grid Padding="10" ColumnDefinitions="130,300,360,100,110,130,150,140,170,140,170" ColumnSpacing="12" BackgroundColor="#E8F2EF">
                                                <Label Text="Code" FontAttributes="Bold" TextColor="#12312D" />
                                                <Label Grid.Column="1" Text="Name" FontAttributes="Bold" TextColor="#12312D" />
                                                <Label Grid.Column="2" Text="Description" FontAttributes="Bold" TextColor="#12312D" />
                                                <Label Grid.Column="3" Text="On Hand" FontAttributes="Bold" TextColor="#12312D" />
                                                <Label Grid.Column="4" Text="Qty Per Box" FontAttributes="Bold" TextColor="#12312D" />
                                                <Label Grid.Column="5" Text="Bataan Retail" FontAttributes="Bold" TextColor="#12312D" />
                                                <Label Grid.Column="6" Text="Bataan Wholesale" FontAttributes="Bold" TextColor="#12312D" />
                                                <Label Grid.Column="7" Text="Pampanga Retail" FontAttributes="Bold" TextColor="#12312D" />
                                                <Label Grid.Column="8" Text="Pampanga Wholesale" FontAttributes="Bold" TextColor="#12312D" />
                                                <Label Grid.Column="9" Text="Zambales Retail" FontAttributes="Bold" TextColor="#12312D" />
                                                <Label Grid.Column="10" Text="Zambales Wholesale" FontAttributes="Bold" TextColor="#12312D" />
                                            </Grid>
                                        </CollectionView.Header>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border StrokeThickness="0" BackgroundColor="Transparent">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup Name="CommonStates">
                                                            <VisualState Name="Normal" />
                                                            <VisualState Name="Selected">
                                                                <VisualState.Setters>
                                                                    <Setter Property="BackgroundColor" Value="#38DCC8" />
                                                                    <Setter Property="Stroke" Value="#FFFFFF" />
                                                                    <Setter Property="StrokeThickness" Value="2" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>
                                                    <Grid Padding="10" ColumnDefinitions="130,300,360,100,110,130,150,140,170,140,170" ColumnSpacing="12" MinimumHeightRequest="52">
                                                        <Label Text="{Binding ItemCode}" LineBreakMode="TailTruncation" />
                                                        <Label Grid.Column="1" Text="{Binding ItemName}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                                        <Label Grid.Column="2" Text="{Binding ItemDescription}" LineBreakMode="TailTruncation" />
                                                        <Label Grid.Column="3" Text="{Binding itemDetails.OnHand, StringFormat='{0:N0}'}" />
                                                        <Label Grid.Column="4" Text="{Binding itemDetails.QuantityPerBox, StringFormat='{0:N0}'}" />
                                                        <Label Grid.Column="5" Text="{Binding itemDetails.BataanRetail, StringFormat='{0:N2}'}" />
                                                        <Label Grid.Column="6" Text="{Binding itemDetails.BataanWholeSale, StringFormat='{0:N2}'}" />
                                                        <Label Grid.Column="7" Text="{Binding itemDetails.PampangaRetail, StringFormat='{0:N2}'}" />
                                                        <Label Grid.Column="8" Text="{Binding itemDetails.PampangaWholeSale, StringFormat='{0:N2}'}" />
                                                        <Label Grid.Column="9" Text="{Binding itemDetails.ZambalesRetail, StringFormat='{0:N2}'}" />
                                                        <Label Grid.Column="10" Text="{Binding itemDetails.ZambalesWholeSale, StringFormat='{0:N2}'}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </ScrollView>
                            </Grid>

                            <Grid IsVisible="{Binding IsMaintenanceReportsTab}" RowDefinitions="Auto,*" RowSpacing="12">
                                <Label Text="Reports" FontSize="18" FontAttributes="Bold" />
                                <VerticalStackLayout Grid.Row="1" Spacing="12" WidthRequest="360" HorizontalOptions="Start">
                                    <Button Text="Profit Per Month" HeightRequest="54" Command="{Binding ProfitPerMonthReportCommand}" />
                                    <Button Text="Item sales" HeightRequest="54" Command="{Binding ItemSalesReportCommand}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>

                    <HorizontalStackLayout Grid.Row="2" Spacing="10">
                        <Button Text="Edit" WidthRequest="110" Command="{Binding MaintenanceEditCommand}" />
                        <Button Text="Add" WidthRequest="110" Command="{Binding MaintenanceAddCommand}" />
                        <Button Text="Import via Excel"
                                WidthRequest="160"
                                IsVisible="{Binding IsMaintenanceItemsTab}"
                                Command="{Binding MaintenanceImportExcelCommand}" />
                        <Button Text="Refresh" WidthRequest="120" Command="{Binding MaintenanceRefreshCommand}" />
                    </HorizontalStackLayout>
                </Grid>
        </Grid>

        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsMaintenanceEditorOpen}"
              BackgroundColor="#99000000"
              Padding="24">
            <Border WidthRequest="760"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="22"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#17211F}"
                    Stroke="{AppThemeBinding Light=#CAD6D2, Dark=#31423E}">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
                    <Label Text="{Binding MaintenanceEditorTitle}"
                           FontSize="22"
                           FontAttributes="Bold" />

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="14">
                            <Grid IsVisible="{Binding IsMaintenanceAgentEditor}"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="14"
                                  RowDefinitions="Auto,Auto,Auto">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Username" />
                                    <Entry Text="{Binding EditAgentUsername}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="5">
                                    <Label Text="Password" />
                                    <Entry Text="{Binding EditAgentPassword}" IsPassword="True" Placeholder="Leave blank to keep current password" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Spacing="5">
                                    <Label Text="Agent name" />
                                    <Entry Text="{Binding EditAgentName}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5">
                                    <Label Text="Contact number" />
                                    <Entry Text="{Binding EditAgentContact}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Spacing="5">
                                    <Label Text="Role" />
                                    <Entry Text="{Binding EditAgentRole}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="5">
                                    <Label Text="Address" />
                                    <Entry Text="{Binding EditAgentAddress}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid IsVisible="{Binding IsMaintenanceAccountEditor}"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="14"
                                  RowDefinitions="Auto,Auto,Auto">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Account name" />
                                    <Entry Text="{Binding EditAccountName}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="5">
                                    <Label Text="Contact person" />
                                    <Entry Text="{Binding EditAccountContactPerson}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Spacing="5">
                                    <Label Text="Email" />
                                    <Entry Text="{Binding EditAccountEmail}" Keyboard="Email" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="5">
                                    <Label Text="Contact number" />
                                    <Entry Text="{Binding EditAccountContactNumber}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Spacing="5">
                                    <Label Text="Terms" />
                                    <Entry Text="{Binding EditAccountTerms}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="5">
                                    <Label Text="Address" />
                                    <Entry Text="{Binding EditAccountAddress}" />
                                </VerticalStackLayout>
                            </Grid>

                            <Grid IsVisible="{Binding IsMaintenanceItemEditor}"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="14"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                <VerticalStackLayout Spacing="5">
                                    <Label Text="Code" />
                                    <Entry Text="{Binding EditItemCode}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="5">
                                    <Label Text="Name" />
                                    <Entry Text="{Binding EditItemName}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="5">
                                    <Label Text="Description" />
                                    <Editor Text="{Binding EditItemDescription}" AutoSize="TextChanges" HeightRequest="72" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Spacing="5">
                                    <Label Text="On hand" />
                                    <Entry Text="{Binding EditItemOnHand}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="5">
                                    <Label Text="Qty per box" />
                                    <Entry Text="{Binding EditItemQuantityPerBox}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="3" Spacing="5">
                                    <Label Text="Bataan retail" />
                                    <Entry Text="{Binding EditItemBataanRetail}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="5">
                                    <Label Text="Bataan wholesale" />
                                    <Entry Text="{Binding EditItemBataanWholesale}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="4" Spacing="5">
                                    <Label Text="Pampanga retail" />
                                    <Entry Text="{Binding EditItemPampangaRetail}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="4" Grid.Column="1" Spacing="5">
                                    <Label Text="Pampanga wholesale" />
                                    <Entry Text="{Binding EditItemPampangaWholesale}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="5" Spacing="5">
                                    <Label Text="Zambales retail" />
                                    <Entry Text="{Binding EditItemZambalesRetail}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="5" Grid.Column="1" Spacing="5">
                                    <Label Text="Zambales wholesale" />
                                    <Entry Text="{Binding EditItemZambalesWholesale}" Keyboard="Numeric" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </ScrollView>

                    <HorizontalStackLayout Grid.Row="2"
                                           Spacing="10"
                                           HorizontalOptions="End">
                        <Button Text="Cancel"
                                WidthRequest="120"
                                BackgroundColor="#52615E"
                                Command="{Binding MaintenanceCancelEditorCommand}" />
                        <Button Text="Save"
                                WidthRequest="140"
                                Command="{Binding MaintenanceSaveEditorCommand}" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
